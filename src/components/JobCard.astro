---
import RoleIcon from './RoleIcon.astro';

interface Props {
  slug: string;
  titel: string;
  functieSlug: string;
  icoon: string;
  regio: string;
  uren: string;
  dienstverband: string;
  tone?: 'teal' | 'clay';
}

const { slug, titel, functieSlug, icoon, regio, uren, dienstverband, tone = 'teal' } = Astro.props;
const btnTone =
  tone === 'clay'
    ? 'text-clay-700 bg-clay-50 hover:bg-clay-600 hover:text-white'
    : 'text-teal-700 bg-teal-50 hover:bg-teal-600 hover:text-white';
---

<article
  class="job-card bg-white rounded-2xl border border-navy-50 p-6 flex flex-col shadow-[0_2px_16px_-8px_rgba(22,38,74,0.08)]"
  data-functie={functieSlug}
  data-regio={regio}
>
  <div class="flex items-start gap-4 mb-5">
    <RoleIcon icoon={icoon} tone={tone} />
    <div>
      <h3 class="font-display font-bold text-lg text-navy-700 leading-snug">{titel}</h3>
    </div>
  </div>

  <ul class="space-y-2 text-[14px] text-navy-400 mb-6">
    <li class="flex items-center gap-2">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#8792A8" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
      {regio}
    </li>
    <li class="flex items-center gap-2">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#8792A8" stroke-width="2"><circle cx="12" cy="12" r="9"></circle><polyline points="12 7 12 12 15.5 14"></polyline></svg>
      {uren}
    </li>
    <li class="flex items-center gap-2">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#8792A8" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2"></rect><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"></path></svg>
      {dienstverband}
    </li>
  </ul>

  <a
    href={`/vacatures/${slug}`}
    class={`mt-auto inline-flex items-center justify-between gap-2 rounded-xl font-semibold text-sm px-4 py-3 transition-colors ${btnTone}`}
  >
    Bekijk vacature
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
  </a>
</article>
