<section class="relative overflow-hidden bg-white py-20 lg:py-24">
  <div class="mx-auto max-w-content px-6 lg:px-10">
    <div class="relative overflow-hidden rounded-3xl bg-navy-700 grid lg:grid-cols-2">
      <div class="p-8 sm:p-12 flex flex-col justify-center">
        <p class="text-clay-400 font-semibold tracking-wide text-sm mb-3">Contact</p>
        <h2 class="font-display font-extrabold text-3xl text-white leading-snug mb-4">
          Hulp nodig bij het vinden van een passende vacature?
        </h2>
        <p class="text-navy-100 leading-relaxed mb-8 max-w-md">
          Ons team helpt je graag verder met persoonlijk advies over vacatures, zorgorganisaties en jouw
          carrièremogelijkheden.
        </p>

        <div class="grid sm:grid-cols-3 gap-4">
          <a href="tel:0850606333" class="rounded-xl bg-white/5 hover:bg-white/10 p-4 transition-colors">
            <span class="inline-flex items-center justify-center w-9 h-9 rounded-full bg-clay-500/20 text-clay-400 mb-3">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
            </span>
            <p class="font-semibold text-white text-sm">Bel ons</p>
            <p class="text-navy-100 text-sm">085 - 06 06 333</p>
          </a>
          <a href="mailto:info@p1zorg.nl" class="rounded-xl bg-white/5 hover:bg-white/10 p-4 transition-colors">
            <span class="inline-flex items-center justify-center w-9 h-9 rounded-full bg-teal-500/20 text-teal-400 mb-3">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 4h16v16H4z" opacity="0"></path><path d="M4 6h16v12H4z"></path><path d="M4 7l8 6 8-6"></path></svg>
            </span>
            <p class="font-semibold text-white text-sm">Mail ons</p>
            <p class="text-navy-100 text-sm">info@p1zorg.nl</p>
          </a>
          <a href="/vacatures#open-sollicitatie" class="rounded-xl bg-white/5 hover:bg-white/10 p-4 transition-colors">
            <span class="inline-flex items-center justify-center w-9 h-9 rounded-full bg-clay-500/20 text-clay-400 mb-3">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
            </span>
            <p class="font-semibold text-white text-sm">Plan een kennismaking</p>
            <p class="text-navy-100 text-sm">Samen kijken we naar jouw mogelijkheden</p>
          </a>
        </div>
      </div>

      <div class="relative hidden lg:block min-h-[320px]">
        <img
          src="/images/contact.svg"
          alt="P1Zorg medewerker klaar om je te helpen"
          class="absolute inset-0 w-full h-full object-cover"
        />
      </div>
    </div>
  </div>
</section>
