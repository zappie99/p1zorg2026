---
---

<section class="relative overflow-hidden bg-sand-50">
  <div class="mx-auto max-w-content px-6 lg:px-10 pt-14 lg:pt-20 pb-0">
    <div class="grid lg:grid-cols-2 gap-10 items-center">
      <div>
        <h1 class="font-display font-extrabold text-[2.4rem] leading-[1.1] sm:text-5xl lg:text-[3.2rem]">
          <span class="block text-navy-700">Jij zorgt voor anderen.</span>
          <span class="block text-teal-600">Wij zorgen voor jou.</span>
        </h1>
        <p class="mt-6 text-navy-400 text-lg leading-relaxed max-w-md">
          Persoonlijke begeleiding, flexibele diensten en de leukste zorgopdrachten in Brabant en
          daarbuiten.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-4">
          <a
            href="/vacatures"
            class="inline-flex items-center gap-2 rounded-full bg-navy-700 hover:bg-navy-800 text-white font-semibold px-6 py-3.5 transition-colors"
          >
            Bekijk vacatures
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
          <a
            href="/vacatures#open-sollicitatie"
            class="inline-flex items-center gap-2 rounded-full bg-white border border-navy-100 hover:border-teal-400 text-teal-600 font-semibold px-6 py-3.5 transition-colors"
          >
            Schrijf je direct in
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>
      </div>

      <div class="relative">
        <div class="aspect-[4/3] rounded-3xl overflow-hidden bg-navy-50">
          <img
            src="/images/hero-home.svg"
            alt="Zorgprofessional van P1Zorg in gesprek met een cliënt"
            class="w-full h-full object-cover"
            loading="eager"
          />
        </div>
      </div>
    </div>
  </div>

  <div class="mt-14 border-t border-navy-100 bg-white/70">
    <div class="mx-auto max-w-content px-6 lg:px-10 py-8">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-8">
        {[
          { label: 'Persoonlijke begeleiding', icon: 'people' },
          { label: 'Flexibel of vast werken jij bepaalt', icon: 'calendar' },
          { label: 'Opdrachten die bij jou passen', icon: 'heart' },
          { label: 'Waardering voor jouw werk', icon: 'smile' },
        ].map((item) => (
          <div class="flex items-center gap-3">
            <span class="flex items-center justify-center w-11 h-11 rounded-full bg-teal-50 text-teal-600 shrink-0">
              {item.icon === 'people' && (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
              )}
              {item.icon === 'calendar' && (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
              )}
              {item.icon === 'heart' && (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z"></path></svg>
              )}
              {item.icon === 'smile' && (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M8 14s1.5 2 4 2 4-2 4-2"></path><line x1="9" y1="9" x2="9.01" y2="9"></line><line x1="15" y1="9" x2="15.01" y2="9"></line></svg>
              )}
            </span>
            <span class="text-[15px] font-semibold text-navy-700 leading-snug">{item.label}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
