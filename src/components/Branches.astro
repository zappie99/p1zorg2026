---
const branches = [
  {
    naam: 'Ouderenzorg',
    omschrijving: 'Zorg met aandacht en respect voor ouderen, zodat zij prettig en veilig kunnen blijven wonen en leven.',
    icoon: 'ouderen',
  },
  {
    naam: 'Geestelijke gezondheidszorg',
    omschrijving: 'Ondersteuning en begeleiding voor mensen met psychische klachten, gericht op herstel en perspectief.',
    icoon: 'ggz',
  },
  {
    naam: 'Gehandicaptenzorg',
    omschrijving: 'Persoonlijke zorg en ondersteuning voor mensen met een beperking, zodat zij zo zelfstandig mogelijk kunnen meedoen.',
    icoon: 'gehandicaptenzorg',
  },
];
---

<section id="branches" class="relative overflow-hidden bg-mist-50 py-20 lg:py-28">
  <div class="blob w-72 h-72 bg-teal-100/50 right-0 top-0 hidden md:block"></div>

  <div class="relative mx-auto max-w-content px-6 lg:px-10 text-center">
    <p class="text-teal-600 font-semibold tracking-wide text-sm mb-3">Onze branches</p>
    <h2 class="font-display font-extrabold text-3xl lg:text-4xl leading-snug max-w-2xl mx-auto">
      Wij zijn actief in de zorg waar mensen dagelijks <span class="text-teal-600">het verschil maken</span>.
    </h2>

    <div class="mt-14 grid sm:grid-cols-3 gap-10 lg:gap-6 lg:divide-x lg:divide-navy-100">
      {branches.map((branche) => (
        <div class="px-4">
          <span class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-teal-50 mb-5">
            {branche.icoon === 'ouderen' && (
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#1F9C8E" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="8" cy="6" r="2.6"></circle>
                <circle cx="16" cy="6" r="2.6"></circle>
                <path d="M4 20c0-3.5 1.9-6 4-6s4 2.5 4 6"></path>
                <path d="M12 20c0-3.5 1.9-6 4-6s4 2.5 4 6"></path>
                <path d="M12.5 4.3c.8-.9 2.2-.9 3 0" opacity="0.6"></path>
              </svg>
            )}
            {branche.icoon === 'ggz' && (
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#1F9C8E" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 4a5 5 0 0 0-5 5c0 2 1 3.3 2 4.3V17a2 2 0 0 0 2 2h4a2 2 0 0 0 2-2v-1"></path>
                <path d="M9 4a5 5 0 0 1 5 5c0 1.6-.6 2.7-1.4 3.6" opacity="0.5"></path>
                <path d="M18.5 8.5c.8-.9 2.2-.9 3 0" opacity="0.6"></path>
              </svg>
            )}
            {branche.icoon === 'gehandicaptenzorg' && (
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#1F9C8E" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="9" cy="5" r="2"></circle>
                <path d="M9 8v5l3.5 2.5"></path>
                <circle cx="13" cy="18" r="4.2"></circle>
                <path d="M9 13H6" opacity="0.6"></path>
              </svg>
            )}
          </span>
          <h3 class="font-display font-bold text-xl text-navy-700 mb-3">{branche.naam}</h3>
          <p class="text-navy-400 leading-relaxed">{branche.omschrijving}</p>
        </div>
      ))}
    </div>
  </div>
</section>
