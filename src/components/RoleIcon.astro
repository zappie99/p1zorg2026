---
interface Props {
  icoon: string;
  tone?: 'teal' | 'clay';
  size?: 'sm' | 'md';
}
const { icoon, tone = 'teal', size = 'md' } = Astro.props;

const bg = tone === 'teal' ? 'bg-teal-50' : 'bg-clay-50';
const stroke = tone === 'teal' ? '#1F9C8E' : '#F07C2E';
const dims = size === 'sm' ? 'w-11 h-11' : 'w-16 h-16';
const iconSize = size === 'sm' ? 20 : 26;
---

<span class={`inline-flex items-center justify-center rounded-full ${bg} ${dims} shrink-0`}>
  {icoon === 'helpende' && (
    <svg width={iconSize} height={iconSize} viewBox="0 0 24 24" fill="none" stroke={stroke} stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="7" r="3.2"></circle>
      <path d="M5.5 21c0-4 3-6.5 6.5-6.5s6.5 2.5 6.5 6.5"></path>
      <path d="M16.5 9.5c1 .3 1.7 1.1 1.7 2" opacity="0.7"></path>
    </svg>
  )}
  {icoon === 'helpende-plus' && (
    <svg width={iconSize} height={iconSize} viewBox="0 0 24 24" fill="none" stroke={stroke} stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="7" r="3.2"></circle>
      <path d="M5.5 21c0-4 3-6.5 6.5-6.5s6.5 2.5 6.5 6.5"></path>
      <circle cx="18" cy="6" r="2.6" fill={stroke} stroke="none" opacity="0.15"></circle>
      <path d="M18 4.6v2.8M16.6 6h2.8"></path>
    </svg>
  )}
  {icoon === 'verzorgende-ig' && (
    <svg width={iconSize} height={iconSize} viewBox="0 0 24 24" fill="none" stroke={stroke} stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="7" r="3.2"></circle>
      <path d="M5.5 21c0-4 3-6.5 6.5-6.5s6.5 2.5 6.5 6.5"></path>
      <path d="M9.5 6.6c.6 1 1.5 1 2.1 0M9 5.4h6" opacity="0.7"></path>
    </svg>
  )}
  {icoon === 'verpleegkundige' && (
    <svg width={iconSize} height={iconSize} viewBox="0 0 24 24" fill="none" stroke={stroke} stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="6.5" r="2.8"></circle>
      <path d="M6 21c0-3.8 2.7-6.2 6-6.2s6 2.4 6 6.2"></path>
      <path d="M9.5 17.5h5M12 15v5" opacity="0.8"></path>
    </svg>
  )}
  {icoon === 'begeleider' && (
    <svg width={iconSize} height={iconSize} viewBox="0 0 24 24" fill="none" stroke={stroke} stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="9" cy="8" r="2.6"></circle>
      <circle cx="17" cy="9.5" r="1.9"></circle>
      <path d="M4 20c0-3.3 2.2-5.3 5-5.3s5 2 5 5.3"></path>
      <path d="M14.5 20c.2-2.3 1.5-3.7 3-3.7 1.6 0 2.9 1.5 3 3.7" opacity="0.7"></path>
    </svg>
  )}
  {icoon === 'assistent-begeleider' && (
    <svg width={iconSize} height={iconSize} viewBox="0 0 24 24" fill="none" stroke={stroke} stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="7" r="3.2"></circle>
      <path d="M5.5 21c0-4 3-6.5 6.5-6.5s6.5 2.5 6.5 6.5"></path>
      <path d="M12 3.5v0" opacity="0"></path>
      <path d="M9.3 4.3c.9-.7 2.5-.7 3.4 0" opacity="0.6"></path>
    </svg>
  )}
</span>
