---
import { getCollection } from 'astro:content';

const functies = (await getCollection('functies')).sort((a, b) => a.data.volgorde - b.data.volgorde);
const vacatures = await getCollection('vacatures');
const regios = [...new Set(vacatures.map((v) => v.data.regio))].sort();
---

<section class="relative overflow-hidden bg-sand-50">
  <div class="mx-auto max-w-content px-6 lg:px-10 pt-14 lg:pt-16 pb-16">
    <div class="grid lg:grid-cols-2 gap-10 items-center">
      <div>
        <p class="text-teal-600 font-semibold tracking-wide text-sm mb-3">Vacatures</p>
        <h1 class="font-display font-extrabold text-[2.2rem] leading-[1.15] sm:text-[2.6rem] lg:text-5xl text-navy-700">
          Vind jouw volgende baan in de zorg
        </h1>
        <p class="mt-5 text-navy-400 text-lg leading-relaxed max-w-md">
          Of je nu op zoek bent naar een vaste baan, flexibele uren of een nieuwe uitdaging: bij P1Zorg
          vind je vacatures die passen bij jouw wensen en ambities.
        </p>

        <form id="vacature-search" class="mt-8 flex flex-col sm:flex-row gap-3 bg-white rounded-2xl sm:rounded-full p-2 shadow-[0_10px_30px_-10px_rgba(22,38,74,0.15)]">
          <label class="flex-1 flex items-center gap-2 px-4 py-2.5 rounded-full sm:border-r border-navy-50">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#8792A8" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
            <select id="functie-select" class="w-full bg-transparent text-navy-700 text-[15px] focus:outline-none appearance-none">
              <option value="">Zoek op functie</option>
              {functies.map((f) => (
                <option value={f.slug}>{f.data.naam}</option>
              ))}
            </select>
          </label>
          <label class="flex-1 flex items-center gap-2 px-4 py-2.5 rounded-full">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#8792A8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
            <select id="regio-select" class="w-full bg-transparent text-navy-700 text-[15px] focus:outline-none appearance-none">
              <option value="">Zoek op regio</option>
              {regios.map((r) => (
                <option value={r}>{r}</option>
              ))}
            </select>
          </label>
          <button
            type="submit"
            class="inline-flex items-center justify-center gap-2 rounded-full bg-clay-600 hover:bg-clay-700 text-white font-semibold px-6 py-3.5 transition-colors whitespace-nowrap"
          >
            Bekijk vacatures
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </button>
        </form>

        <p class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-navy-700">
          <span class="inline-flex items-center gap-1.5">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#1F9C8E" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="8 12 11 15 16 9"></polyline></svg>
            Persoonlijk contact
          </span>
          <span class="text-navy-100">&bull;</span>
          <span>Betrokken begeleiding</span>
          <span class="text-navy-100">&bull;</span>
          <span>Actief in Zuid-Nederland</span>
        </p>
      </div>

      <div class="relative">
        <div class="aspect-[4/3] rounded-3xl overflow-hidden bg-navy-50">
          <img
            src="/images/hero-vacatures.svg"
            alt="Zorgprofessional van P1Zorg met een cliënt"
            class="w-full h-full object-cover"
            loading="eager"
          />
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('vacature-search');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const list = document.getElementById('vacatures-lijst');
    list?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    window.dispatchEvent(new CustomEvent('p1zorg:filter-apply'));
  });
</script>
