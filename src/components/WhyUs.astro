---
const punten = [
  {
    titel: 'Prioriteit voor de zorg',
    omschrijving: 'De zorg staat bij ons altijd op één.',
    icoon: 'heart',
    tone: 'clay',
  },
  {
    titel: 'Persoonlijk contact',
    omschrijving: 'Korte lijnen, betrokken begeleiding en écht contact.',
    icoon: 'handshake-people',
    tone: 'teal',
  },
  {
    titel: 'Professioneel handelen',
    omschrijving: 'Betrouwbaar, transparant en afspraak is afspraak.',
    icoon: 'shield',
    tone: 'teal',
  },
  {
    titel: 'Partnerschap',
    omschrijving: 'Samen bouwen aan langdurige relaties en duurzame oplossingen.',
    icoon: 'handshake',
    tone: 'clay',
  },
];
---

<section id="waarom-p1zorg" class="relative overflow-hidden bg-white py-20 lg:py-28">
  <div class="blob w-96 h-96 bg-mist-100 -left-24 bottom-0 hidden md:block"></div>
  <div class="blob w-72 h-72 bg-clay-50 right-0 bottom-10 hidden md:block"></div>

  <div class="relative mx-auto max-w-content px-6 lg:px-10">
    <div class="grid lg:grid-cols-2 gap-14 items-start">
      <div>
        <p class="text-teal-600 font-semibold tracking-wide text-sm mb-3">Waarom P1Zorg?</p>
        <h2 class="font-display font-extrabold text-3xl lg:text-[2.6rem] leading-tight">
          <span class="block text-navy-700">Wij geloven in mensen.</span>
          <span class="block text-navy-700">In persoonlijk contact.</span>
          <span class="block text-teal-600">In de zorg.</span>
        </h2>
        <p class="mt-6 text-navy-400 leading-relaxed max-w-md">
          P1Zorg is meer dan een bemiddelaar. Wij zijn een betrokken partner die de zorg kent. Met oog
          voor kwaliteit, persoonlijke aandacht en duurzame samenwerking maken wij elke match waardevol.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 gap-5">
        {punten.map((punt) => (
          <div class="bg-white rounded-2xl border border-navy-50 shadow-[0_2px_20px_-6px_rgba(22,38,74,0.08)] p-6">
            <span class={`inline-flex items-center justify-center w-14 h-14 rounded-full mb-4 ${punt.tone === 'clay' ? 'bg-clay-50' : 'bg-teal-50'}`}>
              {punt.icoon === 'heart' && (
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#F07C2E" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z"></path></svg>
              )}
              {punt.icoon === 'handshake-people' && (
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#1F9C8E" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="7" r="3"></circle><circle cx="17" cy="8" r="2.4"></circle><path d="M3 21c0-3.3 2.2-5.5 5-5.5s5 2.2 5 5.5" opacity="0.85"></path><path d="M13 21c.15-2.4 1.6-3.9 3.2-3.9 1.7 0 3.1 1.6 3.2 3.9" opacity="0.6"></path></svg>
              )}
              {punt.icoon === 'shield' && (
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#1F9C8E" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v6c0 4.5-3 7.7-7 9-4-1.3-7-4.5-7-9V6l7-3z"></path><polyline points="9 12 11 14 15 10"></polyline></svg>
              )}
              {punt.icoon === 'handshake' && (
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#F07C2E" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12l4-4 4 2 3-3 4 4-3 3"></path><path d="M6 8l5 5"></path><path d="M14 10l4 4-3 3-4-4"></path></svg>
              )}
            </span>
            <h3 class="font-display font-bold text-lg text-navy-700 mb-1.5">{punt.titel}</h3>
            <p class="text-navy-400 text-[15px] leading-relaxed">{punt.omschrijving}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
