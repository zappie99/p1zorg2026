---
import { getCollection, getEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import RoleIcon from '../../components/RoleIcon.astro';
import JobCard from '../../components/JobCard.astro';
import ContactCTA from '../../components/ContactCTA.astro';

export async function getStaticPaths() {
  const vacatures = await getCollection('vacatures');
  return vacatures.map((vacature) => ({
    params: { slug: vacature.slug },
    props: { vacature },
  }));
}

const { vacature } = Astro.props;
const { Content } = await vacature.render();

const functie = await getEntry('functies', vacature.data.functie);
const alleVacatures = await getCollection('vacatures');
const gerelateerd = alleVacatures
  .filter((v) => v.slug !== vacature.slug && v.data.functie === vacature.data.functie)
  .slice(0, 3);

const functieMap = new Map((await getCollection('functies')).map((f) => [f.slug, f.data]));
---

<Layout title={vacature.data.titel} description={vacature.data.samenvatting}>
  <section class="relative overflow-hidden bg-sand-50 py-14 lg:py-16">
    <div class="mx-auto max-w-content px-6 lg:px-10">
      <a href="/vacatures" class="inline-flex items-center gap-1.5 text-sm text-navy-400 hover:text-teal-600 mb-6">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
        Terug naar alle vacatures
      </a>

      <div class="flex items-start gap-5">
        <RoleIcon icoon={functie?.data.icoon ?? 'helpende'} tone="teal" size="md" />
        <div>
          <p class="text-teal-600 font-semibold text-sm mb-1">{functie?.data.naam}</p>
          <h1 class="font-display font-extrabold text-3xl lg:text-4xl text-navy-700 leading-tight">
            {vacature.data.titel}
          </h1>
          <div class="mt-4 flex flex-wrap gap-x-5 gap-y-2 text-[15px] text-navy-400">
            <span class="inline-flex items-center gap-1.5">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#8792A8" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
              {vacature.data.regio}
            </span>
            <span class="inline-flex items-center gap-1.5">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#8792A8" stroke-width="2"><circle cx="12" cy="12" r="9"></circle><polyline points="12 7 12 12 15.5 14"></polyline></svg>
              {vacature.data.uren}
            </span>
            <span class="inline-flex items-center gap-1.5">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#8792A8" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2"></rect><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"></path></svg>
              {vacature.data.dienstverband}
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white py-14 lg:py-16">
    <div class="mx-auto max-w-content px-6 lg:px-10">
      <div class="grid lg:grid-cols-[1fr_320px] gap-12">
        <div class="prose prose-navy max-w-none prose-headings:font-display prose-headings:text-navy-700 prose-a:text-teal-600">
          <Content />
        </div>

        <aside class="lg:sticky lg:top-28 h-fit rounded-2xl border border-navy-50 bg-mist-50 p-7">
          <p class="font-display font-bold text-lg text-navy-700 mb-2">Interesse in deze functie?</p>
          <p class="text-navy-400 text-sm leading-relaxed mb-6">
            Solliciteer direct of neem contact op met ons team voor meer informatie over deze vacature.
          </p>
          <a
            href={`mailto:info@p1zorg.nl?subject=Sollicitatie: ${encodeURIComponent(vacature.data.titel)}`}
            class="inline-flex w-full items-center justify-center gap-2 rounded-full bg-clay-600 hover:bg-clay-700 text-white font-semibold px-6 py-3.5 transition-colors mb-3"
          >
            Solliciteer direct
          </a>
          <a
            href="tel:0850606333"
            class="inline-flex w-full items-center justify-center gap-2 rounded-full border border-navy-100 text-navy-700 font-semibold px-6 py-3.5 hover:border-teal-400 transition-colors"
          >
            Bel 085 - 06 06 333
          </a>
        </aside>
      </div>
    </div>
  </section>

  {gerelateerd.length > 0 && (
    <section class="bg-mist-50 py-16 lg:py-20">
      <div class="mx-auto max-w-content px-6 lg:px-10">
        <h2 class="font-display font-extrabold text-2xl text-navy-700 mb-8">Vergelijkbare vacatures</h2>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {gerelateerd.map((v, i) => {
            const f = functieMap.get(v.data.functie);
            return (
              <JobCard
                slug={v.slug}
                titel={v.data.titel}
                functieSlug={v.data.functie}
                icoon={f?.icoon ?? 'helpende'}
                regio={v.data.regio}
                uren={v.data.uren}
                dienstverband={v.data.dienstverband}
                tone={i % 2 === 0 ? 'teal' : 'clay'}
              />
            );
          })}
        </div>
      </div>
    </section>
  )}

  <ContactCTA />
</Layout>
