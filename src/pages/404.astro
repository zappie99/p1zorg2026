---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Pagina niet gevonden">
  <section class="bg-sand-50 py-28 text-center">
    <div class="mx-auto max-w-content px-6">
      <p class="text-teal-600 font-semibold tracking-wide text-sm mb-3">404</p>
      <h1 class="font-display font-extrabold text-3xl lg:text-4xl text-navy-700 mb-4">
        Deze pagina bestaat niet (meer)
      </h1>
      <p class="text-navy-400 max-w-md mx-auto mb-8">
        De pagina die je zoekt is verplaatst of bestaat niet. Bekijk onze actuele vacatures of ga terug
        naar de homepage.
      </p>
      <div class="flex items-center justify-center gap-4">
        <a href="/" class="inline-flex items-center gap-2 rounded-full bg-navy-700 text-white font-semibold px-6 py-3.5">
          Naar de homepage
        </a>
        <a href="/vacatures" class="inline-flex items-center gap-2 rounded-full border border-navy-100 text-navy-700 font-semibold px-6 py-3.5">
          Bekijk vacatures
        </a>
      </div>
    </div>
  </section>
</Layout>
