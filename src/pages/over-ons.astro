---
import Layout from '../layouts/Layout.astro';
import WhyUs from '../components/WhyUs.astro';
import Stats from '../components/Stats.astro';
import ContactCTA from '../components/ContactCTA.astro';
---

<Layout title="Over P1Zorg" description="Lees meer over P1Zorg, hoe wij zorgprofessionals verbinden met zorginstellingen in Zuid-Nederland.">
  <section class="bg-sand-50 py-20 lg:py-24">
    <div class="mx-auto max-w-content px-6 lg:px-10 max-w-2xl">
      <p class="text-teal-600 font-semibold tracking-wide text-sm mb-3">Over ons</p>
      <h1 class="font-display font-extrabold text-3xl lg:text-4xl text-navy-700 mb-5">
        Meer dan een bemiddelaar
      </h1>
      <p class="text-navy-400 leading-relaxed">
        P1Zorg verbindt zorgprofessionals met zorginstellingen in Zuid-Nederland. Met persoonlijke
        aandacht en expertise zorgen wij voor de juiste match, zodat zorginstellingen kunnen rekenen op
        betrouwbare ondersteuning en professionals op werk dat écht bij hen past. Sinds 2019 bouwen wij
        aan duurzame relaties tussen zorgprofessionals en zorgorganisaties.
      </p>
    </div>
  </section>
  <WhyUs />
  <Stats />
  <ContactCTA />
</Layout>
