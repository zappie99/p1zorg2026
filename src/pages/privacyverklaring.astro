---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Privacyverklaring">
  <section class="bg-white py-20">
    <div class="mx-auto max-w-content px-6 lg:px-10 max-w-2xl prose prose-navy">
      <h1>Privacyverklaring</h1>
      <p>
        Dit is een placeholder-pagina. Vul hier de privacyverklaring van P1Zorg B.V. in, met daarin
        onder meer welke persoonsgegevens worden verwerkt, met welk doel, en hoe sollicitanten en
        bezoekers hun rechten kunnen uitoefenen.
      </p>
    </div>
  </section>
</Layout>
